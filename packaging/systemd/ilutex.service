[Unit]
Description=iLutex — restaura el color al iniciar sesión
# Tras la sesión gráfica; evita After=default.target + WantedBy=default.target.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
# --on-login respeta restore_policy=never del estado persistido.
ExecStart=/usr/bin/ilutex restore --on-login
RemainAfterExit=yes
# Al iniciar sesión las ACL uaccess pueden no estar aplicadas todavía.
Restart=on-failure
RestartSec=3
# Endurecimiento: sin PrivateDevices (HID /dev/hidraw*) ni ProtectHome (XDG_STATE_HOME).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectClock=yes
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

[Install]
WantedBy=graphical-session.target