#: gui/window.py:1133
msgid ""
"Could not talk to the keyboard. It is usually a system permission and one "
"click fixes it."
msgstr ""
"No se pudo hablar con el teclado. Suele ser un permiso del sistema y se "
"arregla con un clic."

#: gui/window.py:1136
msgid ""
"Could not talk to the keyboard. Install it by hand and retry: sudo install "
"-m644 /usr/lib/udev/rules.d/70-ilutex.rules /etc/udev/rules.d/70-"
"ilutex.rules && sudo udevadm control --reload && sudo udevadm trigger --"
"subsystem-match=hidraw"
msgstr ""
"No se pudo hablar con el teclado. Instálalo a mano y reintenta: sudo "
"install -m644 /usr/lib/udev/rules.d/70-ilutex.rules /etc/udev/rules.d/70-"
"ilutex.rules && sudo udevadm control --reload && sudo udevadm trigger --"
"subsystem-match=hidraw"

#: gui/window.py:1143
msgid "No keyboard access"
msgstr "Sin acceso al teclado"

#: gui/window.py:1149
msgid "Install permission"
msgstr "Instalar permiso"

#: gui/window.py:1150
msgid "Retry"
msgstr "Reintentar"

#: gui/window.py:1186
msgid "Permission not installed (packaged udev rule missing or hash mismatch)."
msgstr ""
"Permiso no instalado (falta la regla udev empaquetada o no coincide el "
"hash)."

#: gui/window.py:1199
msgid "Permission not installed (pkexec cancelled or not authorized)."
msgstr "Permiso no instalado (pkexec cancelado o sin autorización)."
